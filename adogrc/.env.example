# =========================
# Required values
# =========================

# Trusted hosts for web-tier auth.
# Use IP-based entries (DNS names may not be resolved by aserver).
# Keep this aligned with WEBSERVER_IP below.
# If dynamic IP is required, use a broader allowlist pattern as needed
# (for example a subnet/range rule, or "*.*.*.*" if your security policy allows it).
TRUSTED_HOSTS=172.28.12.5


# =========================
# Image locations
# =========================

# ADOGRC images
ADOGRC_ASERVER_IMAGE=<boc-registry>/boc/products/adogrc-aserver:<version>
ADOGRC_WEBSERVER_IMAGE=<boc-registry>/boc/products/adogrc-webserver:<version>


# =========================
# General
# =========================

# Timezone used by services
TZ=UTC

# Change subnet if Docker reports overlap with existing networks on the host.
ADOGRC_SUBNET=172.28.12.0/24
# Must be inside ADOGRC_SUBNET and unique.
WEBSERVER_IP=172.28.12.5

# Linux bind-mount preparation (required when containers run as non-root user "ado").
# Host filesystems enforce numeric UID/GID ownership, not container usernames.
# If host directory ownership does not match the container user UID/GID, writes can fail.
# Verify the runtime UID/GID expected by the image and adjust ownership accordingly.
# Run these commands before "docker compose up" (from this folder):
# mkdir -p logs/aserver logs/webserver data/fts
# sudo chown -R 1100:1100 logs data
# sudo chmod -R u+rwX,g+rwX logs data
# If you customize log mount paths below, create/chown/chmod those paths instead.
# If permissions are wrong, logs/FTS data may stay empty and aserver startup can fail.
# If host ownership management is difficult, use Docker named volumes instead of bind mounts.


# =========================
# External DB settings
# =========================

# Supported values depend on ADOGRC build, e.g. PostgreSQL or SQLServer.
# External database host (DNS name or IP), e.g. db.example.com.
DB_TYPE=PostgreSQL
DB_HOST=<database-hostname>
DB_PORT=5432
DB_NAME=adodb

# SQL Server specific DB connection security options.
# Valid encryption values: Mandatory, Optional, Strict
# Valid trust-server-certificate values: yes, no
ADOXX_DBMS_ENCRYPTION=Optional
ADOXX_DBMS_TRUST_SERVER_CERTIFICATE=no

# =========================
# aserver settings
# =========================

ADOXX_SERVER_PORTS=54321,54322
ASERVER_MEMORY_LIMIT=16g
ASERVER_CPU_LIMIT=6
ASERVER_SHM_SIZE=300mb
# Host path mounted to /aserver/logs in container.
ASERVER_LOGS_MOUNT_PATH=./logs/aserver
# Host path mounted to /fts in container for persistent FTS indexes.
ASERVER_FTS_MOUNT_PATH=./data/fts

ADOXX_LOG_STD_STREAM=1
ADOXX_LOG_MODE=MIXED


# =========================
# webserver settings
# =========================

# Interface to bind Tomcat's published host port.
# Use 127.0.0.1 when a reverse proxy runs on the same host.
# If users on other machines must access ADOGRC directly, set to 0.0.0.0
# (or a host NIC IP) and secure access with firewall/network policy.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8888
WEBSERVER_MEMORY_LIMIT=8g
WEBSERVER_CPU_LIMIT=4
# Host path mounted to /tomcat/logs in container.
WEBSERVER_LOGS_MOUNT_PATH=./logs/webserver

JAVA_OPTS=-Xms512m -Xmx4G
AXW_PROPERTIES_AWORKERS=AS1:54321,AS1:54322
AXW_PROPERTIES_ASERVERS=AS1:aserver
AXW_LOGGER_MODE=MIXED
AXW_LOGGER_CONSOLE_ENABLED=false
AXW_MAIL_MAX_MAIL_SIZE=500
