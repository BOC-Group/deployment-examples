# =========================
# Required values
# =========================

# Trusted hosts for web-tier auth (short, FQDN, and fixed IP forms)
# Keep this aligned with ADONIS_NETWORK_NAME and WEBSERVER_IP below.
TRUSTED_HOSTS=webserver,webserver.adonis,172.28.12.5,localhost


# =========================
# Image locations
# =========================

# ADONIS images
ADONIS_ASERVER_IMAGE=<boc-registry>/adonis/aserver:19.0.0
ADONIS_WEBSERVER_IMAGE=<boc-registry>/adonis/webserver:19.0.0


# =========================
# General
# =========================

# Timezone used by services
TZ=UTC

# Stable Docker network name
ADONIS_NETWORK_NAME=adonis
# Change subnet if Docker reports overlap with existing networks on the host.
ADONIS_SUBNET=172.28.12.0/24
# Must be inside ADONIS_SUBNET and unique.
WEBSERVER_IP=172.28.12.5

# Container names
# Optional: customize if running multiple stacks on same host.
ASERVER_CONTAINER_NAME=aserver
WEBSERVER_CONTAINER_NAME=webserver


# =========================
# External DB settings
# =========================

# Supported values depend on ADONIS build, e.g. PostgreSQL or SQLServer.
DB_TYPE=PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=adodb

# =========================
# aserver settings
# =========================

ASERVER_PORT_1=54321
ASERVER_PORT_2=54322
ADOXX_SERVER_PORTS=54321,54322
ASERVER_SHM_SIZE=300mb

ADOXX_LOG_STD_STREAM=1
ADOXX_LOG_MODE=MIXED


# =========================
# webserver settings
# =========================

HTTP_PORT=8888

JAVA_OPTS=-Xms512m -Xmx2048m -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:8000
AXW_PROPERTIES_AWORKERS=AS1:54321,AS1:54322
AXW_PROPERTIES_ASERVERS=AS1:aserver
AXW_LOGGER_CONSOLE_ENABLED=true
